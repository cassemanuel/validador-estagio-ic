# Ambiente: 'dev' (local) ou 'production'. Fora de dev (ou com AUTH_PROVIDER=ldap)
# a aplicação recusa subir com JWT_SECRET padrão/curto ou sem
# STORAGE_ENCRYPTION_KEY.
ENV=dev

# Sessão — mínimo de 32 caracteres (obrigatório fora de dev)
JWT_SECRET=troque-por-um-segredo-forte-com-pelo-menos-trinta-e-dois-caracteres
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# Chave Fernet dos PDFs at-rest (obrigatória fora de dev). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# Autenticação: 'local' (desenvolvimento) ou 'ldap'
AUTH_PROVIDER=local

# Usuários de desenvolvimento (user:senha:papel:nome;...) — provisionados e
# exibidos como atalhos de login sempre que AUTH_PROVIDER=local
SEED_USERS=aluno1:aluno123:discente:Aluno Exemplo;aluno2:aluno123:discente:Discente Dois;aluno3:aluno123:discente:Discente Três;comissao1:comissao123:comissao:Membro da Comissão

# LDAP institucional (quando AUTH_PROVIDER=ldap)
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_COMISSAO=
COMMISSION_USERS=

# Conferência automática do texto dos PDFs: 'bloquear' (padrão, HTTP 422 se
# nome/DRE não conferem) ou 'alertar' (contingência para mudança de layout do
# SIGA: aceita e encaminha à Mesa de Revisão com alerta)
IDENTIDADE_PDF_MODO=bloquear

# LGPD / expurgo do PDF bruto
PDF_RETENTION_DAYS=30
PURGE_INTERVAL_SECONDS=3600

# Retenção de deliberações e logs antes do arquivamento (dias, ~6 meses)
AUDIT_RETENTION_DAYS=183
ARCHIVE_DIR=./data/archive

# Validade da autorização de estágio após a liberação (dias)
AUTORIZACAO_VALIDADE_DIAS=90

# Renovação: nova submissão só quando faltam N dias ou menos para vencer
RENOVACAO_JANELA_DIAS=30

# Janela de alerta para autorizações próximas do vencimento (dias)
VENCIMENTO_ALERTA_DIAS=30
