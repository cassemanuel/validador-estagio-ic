# Sessão — mínimo recomendado de 32 bytes para HMAC-SHA256
JWT_SECRET=troque-por-um-segredo-forte-com-pelo-menos-trinta-e-dois-caracteres
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false

# Autenticação: 'local' (desenvolvimento) ou 'ldap'
AUTH_PROVIDER=local

# Usuários de desenvolvimento (user:senha:papel:nome;...)
SEED_USERS=aluno1:aluno123:discente:Aluno Exemplo;aluno2:aluno123:discente:Discente Dois;aluno3:aluno123:discente:Discente Três;comissao1:comissao123:comissao:Membro da Comissão

# LDAP institucional (quando AUTH_PROVIDER=ldap)
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(uid={username})
LDAP_GROUP_COMISSAO=
COMMISSION_USERS=

# LGPD / expurgo do PDF bruto
PDF_RETENTION_DAYS=30
PURGE_INTERVAL_SECONDS=3600

# Retenção de deliberações e logs antes do arquivamento (dias, ~6 meses)
AUDIT_RETENTION_DAYS=183
ARCHIVE_DIR=./data/archive

# Validade da autorização de estágio após a liberação (dias)
AUTORIZACAO_VALIDADE_DIAS=90

# Janela de alerta para autorizações próximas do vencimento (dias)
VENCIMENTO_ALERTA_DIAS=30
